[
  {
    "label": "RL: play 3D (Bevy)",
    "command": "cargo run -p rl_view",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
  },
  {
    "label": "RL: play 3D (Bevy, release)",
